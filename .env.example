# Copy to .env.local and fill in the values from the Supabase dashboard:
# Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# Optional. Without it the Google Calendar section reports itself unconfigured
# and nothing in the app tries to reach Google.
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID,
# type "Web application". There is no client secret here: the browser uses
# Google's token client, which does not take one.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
